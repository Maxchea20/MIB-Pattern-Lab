//@version=5
// MTF RSI: the RSI of 1m, 5m, 15m, 1H, 4H and 1D on ONE pane. Put the chart on the 1-minute timeframe to see all six.
// "Closed candles only" = each line shows the last COMPLETED candle of its timeframe (steady, never repaints).
// Off = live: each line moves with every tick of its forming candle.
indicator("MTF RSI: 1m 5m 15m 1H 4H 1D", shorttitle="MTF RSI", overlay=false, precision=1)

len        = input.int(14, "RSI length", minval=2)
src        = input.source(close, "Source")
closedOnly = input.bool(true, "Closed candles only (steady). Off = live, moves every tick")
showFill   = input.bool(true, "Shade overbought / oversold zones")
showTable  = input.bool(true, "Show table of latest values")

// both versions are always calculated, then one is chosen (keeps Pine's calculation consistent on every bar)
f_closed(tf) => request.security(syminfo.tickerid, tf, ta.rsi(src, len)[1], lookahead = barmerge.lookahead_on)
f_live(tf)   => request.security(syminfo.tickerid, tf, ta.rsi(src, len))
f_lower(tf)  => timeframe.in_seconds(tf) < timeframe.in_seconds()   // a timeframe below the chart's cannot be drawn

c1  = f_closed("1"),   l1  = f_live("1")
c5  = f_closed("5"),   l5  = f_live("5")
c15 = f_closed("15"),  l15 = f_live("15")
c60 = f_closed("60"),  l60 = f_live("60")
c240 = f_closed("240"), l240 = f_live("240")
c1d = f_closed("D"),   l1d = f_live("D")

r1   = f_lower("1")   ? na : (closedOnly ? c1   : l1)
r5   = f_lower("5")   ? na : (closedOnly ? c5   : l5)
r15  = f_lower("15")  ? na : (closedOnly ? c15  : l15)
r60  = f_lower("60")  ? na : (closedOnly ? c60  : l60)
r240 = f_lower("240") ? na : (closedOnly ? c240 : l240)
r1d  = f_lower("D")   ? na : (closedOnly ? c1d  : l1d)

h70  = hline(70,  "70",  color=color.new(color.gray, 40), linestyle=hline.style_dashed)
h50  = hline(50,  "50",  color=color.new(color.gray, 70), linestyle=hline.style_dotted)
h30  = hline(30,  "30",  color=color.new(color.gray, 40), linestyle=hline.style_dashed)
h100 = hline(100, "100", display=display.none)
h0   = hline(0,   "0",   display=display.none)
fill(h70, h100, color = showFill ? color.new(color.red,   90) : na)
fill(h0,  h30,  color = showFill ? color.new(color.green, 90) : na)

plot(r1,   "RSI 1m",  color=#9aa5b1, linewidth=1, style=plot.style_stepline)
plot(r5,   "RSI 5m",  color=#6cb4ee, linewidth=1, style=plot.style_stepline)
plot(r15,  "RSI 15m", color=#1f6fe0, linewidth=2, style=plot.style_stepline)
plot(r60,  "RSI 1H",  color=#f5a623, linewidth=2, style=plot.style_stepline)
plot(r240, "RSI 4H",  color=#e63946, linewidth=3, style=plot.style_stepline)
plot(r1d,  "RSI 1D",  color=#8e44ad, linewidth=3, style=plot.style_stepline)

f_col(v) => na(v) ? color.gray : v <= 30 ? color.lime : v >= 70 ? color.red : color.white
var table tb = table.new(position.top_right, 2, 7, border_width=1)
if showTable and barstate.islast
    table.cell(tb, 0, 0, "TF",  text_color=color.gray)
    table.cell(tb, 1, 0, closedOnly ? "RSI (closed)" : "RSI (live)", text_color=color.gray)
    names = array.from("1m", "5m", "15m", "1H", "4H", "1D")
    vals  = array.from(r1, r5, r15, r60, r240, r1d)
    for i = 0 to 5
        v = array.get(vals, i)
        table.cell(tb, 0, i + 1, array.get(names, i), text_color=color.white)
        table.cell(tb, 1, i + 1, na(v) ? "n/a" : str.tostring(v, "#.0"), text_color=f_col(v))
