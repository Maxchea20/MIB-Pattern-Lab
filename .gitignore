# Market data and secrets: NEVER commit
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Generated output (keep folder, ignore contents except reports kept deliberately)
results/sample_charts/*
!results/sample_charts/.gitkeep
results/single_chart/
results/db_inspection.txt
results/discovery/*
!results/discovery/.gitkeep

# derived per-window outcome data stays local
results/outcomes/**/observations.csv

# 5M experiment: generated chart images stay local (sample list / metadata are small and may be committed)
results/exp5m/**/charts/
